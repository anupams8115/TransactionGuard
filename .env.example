# Copy to .env and edit. Never commit .env.
TG_ENVIRONMENT=development
TG_LOG_LEVEL=INFO
TG_LOG_JSON=false

# Local default is SQLite (no Docker needed). Docker Compose overrides this with PostgreSQL:
# TG_DATABASE_URL=postgresql+psycopg://transactionguard:<password>@localhost:5432/transactionguard
TG_DATABASE_URL=sqlite:///./transactionguard.db

# Celery: eager=true runs batch jobs inline (no Redis). Set false + run a worker for real async jobs.
TG_CELERY_EAGER=true
TG_REDIS_URL=redis://localhost:6379/0

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
TG_JWT_SECRET=<replace-with-a-long-random-secret>
TG_ACCESS_TOKEN_MINUTES=60
TG_COOKIE_SECURE=false

TG_MLFLOW_TRACKING_URI=sqlite:///./mlflow.db
TG_RANDOM_SEED=42
TG_CORS_ORIGINS=http://localhost:3000

# Used only by docker-compose.yml for the PostgreSQL container
POSTGRES_USER=transactionguard
POSTGRES_PASSWORD=<replace-me>
POSTGRES_DB=transactionguard
