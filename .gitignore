# --- Python ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# --- Secrets: never commit real env files ---
.env
.env.*
!.env.example

# --- Data: raw/benchmark data is downloaded, never redistributed ---
data/raw/*
data/processed/*
data/synthetic/*
!data/**/.gitkeep

# --- Generated ML artifacts & tracking stores ---
artifacts/*
!artifacts/.gitkeep
mlruns/
mlartifacts/
mlflow.db
reports/*
!reports/.gitkeep
!reports/README.md

# --- Local databases ---
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite3

# --- Node / Next.js ---
node_modules/
frontend/.next/
frontend/out/
frontend/playwright-report/
frontend/test-results/
*.tsbuildinfo
next-env.d.ts

# --- OS / IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.log
